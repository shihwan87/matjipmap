# tools/insta/.env 로 복사해서 채우세요. 이 파일(.env)은 git에 올라가지 않습니다.
# Supabase 주소와 anon 키는 프로젝트 루트의 .env.local에서 자동으로 읽습니다.

# 앱 로그인 정보 (편집자 이상). 이름 계정이면 이름만, 관리자는 이메일.
MATJIP_LOGIN=
MATJIP_PASSWORD=

# 인스타 '저장됨' 컬렉션 주소. 여러 개면 쉼표로 구분.
# 인스타 웹에서 프로필 → 저장됨 → 컬렉션을 열면 주소창에 보입니다.
INSTA_COLLECTION_URLS=https://www.instagram.com/<내아이디>/saved/<컬렉션이름>/<숫자>/

# Claude 실행 파일 경로. 비워두면 자동으로 찾습니다 (PATH → 데스크톱 앱 내장).
CLAUDE_EXE=

# Claude 모델. 비워두면 기본값. 예: haiku (빠르고 가벼움)
CLAUDE_MODEL=
